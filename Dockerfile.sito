# Il SITO: solo pagine statiche.
#
# Niente Python, niente lab, niente torch. Sul cluster il corso non
# esegue nulla: serve HTML, CSS e tre file JS che girano nel browser.
# L'ambiente di riferimento dei LAB e' un'altra immagine (Dockerfile),
# e le due non vanno confuse: quella pesa un giga, questa qualche mega.
FROM nginx:1.27-alpine

# Solo cio' che il browser chiede. I lab restano fuori di proposito:
# non servono a servire il sito, e pubblicarli qui li esporrebbe come
# se fossero scaricabili da web invece che da git.
COPY corso/*.html        /usr/share/nginx/html/
COPY corso/assets/       /usr/share/nginx/html/assets/

# VERSIONE negli URL degli asset, timbrata al build.
#
# Non e' ridondante col Cache-Control: davanti al cluster c'e'
# Cloudflare, che RISCRIVE le intestazioni di cache dell'origine
# (`no-cache` diventa `max-age=14400`) e serve la sua copia. Con URL
# stabili una release puo' quindi accoppiare HTML nuovo e CSS vecchio —
# ed e' successo davvero: le pagine sono uscite senza i separatori
# perche' il CSS in cache non aveva ancora le classi nuove.
#
# Un URL diverso e' una risorsa diversa per qualunque cache, senza
# dover chiedere il permesso a nessuno. Il sorgente in git resta
# pulito: la marcatura esiste solo dentro l'immagine.
COPY deploy/versiona-asset.sh /tmp/versiona-asset.sh
RUN sh /tmp/versiona-asset.sh && rm /tmp/versiona-asset.sh

COPY deploy/nginx.conf   /etc/nginx/conf.d/default.conf

# nginx:alpine gira gia' come non-root per i worker; il master ha
# bisogno di scrivere pid e cache temporanee, che restano in tmpfs.
EXPOSE 8080
